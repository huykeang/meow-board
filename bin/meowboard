    # ======================================================
    # Local socket
    # ======================================================

    def start_socket_server(self):

        try:

            if os.path.exists(
                SOCKET_FILE
            ):
                os.remove(
                    SOCKET_FILE
                )

            self.server = socket.socket(
                socket.AF_UNIX,
                socket.SOCK_STREAM
            )

            self.server.bind(
                SOCKET_FILE
            )

            self.server.listen(5)

            self.server.setblocking(False)

            GLib.io_add_watch(
                self.server,
                GLib.IO_IN,
                self.on_socket_ready
            )

        except Exception as e:

            print(
                f"Socket error: {e}"
            )

    def on_socket_ready(
        self,
        source,
        condition
    ):

        try:

            conn, _ = self.server.accept()

            command = conn.recv(1024).decode()

            conn.close()

            if command == "toggle":

                if self.is_visible():

                    self.hide()

                else:

                    self.show_clipboard()

        except Exception:
            pass

        return True


def send_command(command):

    try:

        client = socket.socket(
            socket.AF_UNIX,
            socket.SOCK_STREAM
        )

        client.connect(
            SOCKET_FILE
        )

        client.send(
            command.encode()
        )

        client.close()

        return True

    except Exception:

        return False


def main():

    # If already running, toggle it.
    if len(sys.argv) > 1:

        command = sys.argv[1]

        if send_command(command):
            return

    app = ClipboardApp()

    # If launched with "toggle" and no existing instance,
    # show it immediately.
    if len(sys.argv) > 1 and sys.argv[1] == "toggle":
        app.show_clipboard()

    Gtk.main()


if __name__ == "__main__":
    main()